{
  "manifest_version": 3,
  "name": "LocalTab",
  "version": "1.0.0",
  "minimum_chrome_version": "127",
  "description": "A private, local command palette for tabs, bookmarks, and Chrome pages.",
  "permissions": ["activeTab", "scripting", "tabs", "bookmarks", "storage"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
    "default_title": "Open LocalTab"
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "open-command-bar": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+K" },
      "description": "Open LocalTab"
    }
  }
}
